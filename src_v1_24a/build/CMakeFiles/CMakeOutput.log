#include <mpi.h>
int main(int argc, char* argv[]) {
	const int send = 0;
	int recv;
	MPI_Request req;
	MPI_Init(&argc, &argv);
	MPI_Irecv(&recv, 1, MPI_INT, 0, 0, MPI_COMM_WORLD, &req);
	MPI_Send(&send, 1, MPI_INT, 0, 0, MPI_COMM_WORLD);
	MPI_Wait(&req, MPI_STATUS_IGNORE);
	MPI_Finalize();
}
